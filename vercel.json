{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/blog/posts.js": {
      "runtime": "nodejs18.x"
    },
    "api/blog/[slug].js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/blog/posts",
      "destination": "/api/blog/posts.js"
    },
    {
      "source": "/api/blog/:slug",
      "destination": "/api/blog/[slug].js?slug=:slug"
    }
  ]
}
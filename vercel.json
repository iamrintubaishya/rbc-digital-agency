
{
  "version": 2,
  "builds": [
    {
      "src": "dist/public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/blog/posts",
      "dest": "/api/blog/posts.ts"
    },
    {
      "src": "/api/blog/posts/(.*)",
      "dest": "/api/blog/posts.ts"
    },
    {
      "src": "/api/blog/([^/]+)",
      "dest": "/api/blog/[slug].ts?slug=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?__path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/public/$1"
    }
  ]
}


{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/api/blog/posts",
      "dest": "/api/blog/posts.js"
    },
    {
      "src": "/api/blog/([^/]+)",
      "dest": "/api/blog/[slug].js?slug=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

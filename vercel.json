
{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/blog/posts.ts": {
      "runtime": "@vercel/node"
    },
    "api/blog/[slug].ts": {
      "runtime": "@vercel/node"
    },
    "api/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/blog/posts/:path*",
      "destination": "/api/blog/posts"
    },
    {
      "source": "/api/blog/:slug",
      "destination": "/api/blog/[slug]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ]
}
